<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Favorit.ListFav"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             BackgroundColor="#f8fafa"
             NavigationPage.HasNavigationBar="False" Shell.NavBarIsVisible="False" 
             Shell.TabBarIsVisible="True">

    <Grid>
        <RefreshView x:Name="RefreshViewContainer" Refreshing="RefreshViewContainer_Refreshing">
            <ScrollView>
                <Grid RowDefinitions="Auto,*" Padding="10" RowSpacing="10">
                    <!-- Search Header -->
                    <Border Grid.Row="0" Padding="10" StrokeShape="RoundRectangle 10" Stroke="Transparent" StrokeThickness="0.5" BackgroundColor="White">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Opacity="0.10" Radius="12" Offset="0,-3" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="*" ColumnSpacing="10">
                            
                            <Border Grid.Column="1" Padding="0" StrokeShape="RoundRectangle 10" Stroke="#CCCCCC" StrokeThickness="0.5" BackgroundColor="White">
                                <SearchBar Placeholder="Cari Transaksi Favorit..." x:Name="T_Search" TextChanged="T_Search_TextChanged" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Data List Container -->
                    <StackLayout Grid.Row="1" Spacing="10" x:Name="ListContainer">
                        <BindableLayout.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Margin="0,150,0,0">
                                <Image Source="emptylist01.png" WidthRequest="120" HeightRequest="120" HorizontalOptions="Center" />
                                <Label Text="Data transaksi berulang tidak ditemukan" TextColor="#888888" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 10" Padding="12" Margin="0,0,0,8" Stroke="#ccc" StrokeThickness="0.5" BackgroundColor="White">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="FavItem_Tapped" CommandParameter="{Binding id_fav}" />
                                    </Border.GestureRecognizers>
                                    <Border.Shadow>
                                        <Shadow Brush="#000000" Opacity="0.05" Radius="6" Offset="0,2" />
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="6">
                                        <!-- Kategori Icon (Sesuai List_Kategori.xaml) -->
                                        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" StrokeShape="RoundRectangle 15" Stroke="LightGrey" StrokeThickness="0.3" BackgroundColor="{Binding BgColor}" WidthRequest="60" HeightRequest="60" VerticalOptions="Center" Padding="8" HorizontalOptions="Center">
                                            <Border.Shadow>
                                                <Shadow Brush="#000000" Opacity="0.10" Radius="8" Offset="0,2" />
                                            </Border.Shadow>
                                            <Image Source="{Binding FullIconUrl}" Aspect="AspectFit" VerticalOptions="Center" HorizontalOptions="Center" />
                                        </Border>

                                        <!-- Title & Category Info -->
                                        <StackLayout Grid.Column="1" Grid.Row="0" Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding TitleDisplay}" FontAttributes="Bold" FontSize="16" TextColor="#333333" LineBreakMode="TailTruncation" MaxLines="2" />
                                            <Label Text="{Binding nama_kategori}" FontSize="13" TextColor="CornflowerBlue" FontAttributes="Bold" />
                                        </StackLayout>

                                        <!-- Nominal -->
                                        <Label Text="{Binding NominalDisplay}" Grid.Column="2" Grid.Row="0" 
                                               HorizontalOptions="End" HorizontalTextAlignment="End" 
                                               FontSize="17" FontAttributes="Bold" 
                                               TextColor="{Binding NominalColor}" VerticalOptions="Center" />

                                        <!-- Schedule Badge & Type -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1">
                                            <Border Padding="10,3" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#e8f0fe">
                                                <HorizontalStackLayout Spacing="4">
                                                    <Image Source="date100.png" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                                                    <Label Text="{Binding ScheduleDisplay}" VerticalTextAlignment="Center" FontAttributes="Bold" FontSize="12" TextColor="#1967d2" />
                                                </HorizontalStackLayout>
                                            </Border>
                                            <Border Padding="10,3" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{Binding TypeBadgeBg}">
                                                <Label Text="{Binding TypeText}" VerticalTextAlignment="Center" FontAttributes="Bold" FontSize="12" TextColor="{Binding TypeBadgeTextColor}" />
                                            </Border>
                                        </StackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </Grid>
            </ScrollView>
        </RefreshView>

        <!-- Floating Action Button (+) -->
        <Button x:Name="BtnAdd"
                Text="+"
                FontAttributes="Bold"
                FontSize="32"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                BackgroundColor="CornflowerBlue"
                TextColor="White"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,50"
                Clicked="BtnAdd_Clicked">
            <Button.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Offset="0,4" Radius="5" />
            </Button.Shadow>
        </Button>

        <!-- Loading Overlay (3 Detik Delay) -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#80000000" IsVisible="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                <ActivityIndicator IsRunning="{Binding Source={x:Reference LoadingOverlay}, Path=IsVisible}" Color="White" WidthRequest="45" HeightRequest="45" />
                <Label Text="Tunggu sebentar..." TextColor="White" FontAttributes="Bold" FontSize="15" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>