<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Rekening.List_Akun"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             BackgroundColor="#f8fafa" NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             >
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="10" StrokeShape="RoundRectangle 10" Margin="10" Stroke="Transparent" StrokeThickness="0.5" BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.10" Radius="12" Offset="0,-3" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*" ColumnSpacing="10">
                <Border Grid.Column="0" Padding="0" StrokeShape="RoundRectangle 10"  Stroke="#CCCCCC" StrokeThickness="0.5" BackgroundColor="White">
                    <SearchBar Placeholder="Cari akun rekening" x:Name="T_Search"></SearchBar>
                </Border>
            </Grid>

        </Border>

        <Border Grid.Row="1" VerticalOptions="Start" Margin="10,0" StrokeShape="RoundRectangle 10" 
                Stroke="#CCCCCC" StrokeThickness="0.2" BackgroundColor="White">
            <Grid ColumnDefinitions="Auto,*,Auto" Padding="20" ColumnSpacing="15">
                <toolkit:AvatarView Text="A" FontAttributes="Bold" Grid.Column="0" FontSize="20" 
                                    BackgroundColor="CornflowerBlue" TextColor="White" />

                <StackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Bank BCA MANDIRI BRI" FontSize="16" FontAttributes="Bold" TextColor="#444"></Label>
                    <Label Text="27 Juli 2026 10:02" FontSize="Small" TextColor="Grey"></Label>
                </StackLayout>

                <Label Grid.Column="2" FontAttributes="Bold" FontSize="18" TextColor="DarkKhaki"
                       Text="Rp 500.000.000" VerticalOptions="Center"></Label>
            </Grid>
        </Border>
    </Grid>
</ContentPage>