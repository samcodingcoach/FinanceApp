<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Rekening.New_Rekening"
             BackgroundColor="#f8fafa"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Custom Header untuk menghindari bug transisi Navbar di MAUI Android -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,40,20,15" BackgroundColor="White">
            <Grid.Shadow>
                <Shadow Brush="#000000" Opacity="0.05" Radius="5" Offset="0,2" />
            </Grid.Shadow>
            <Label Text="Buat Rekening Saldo" FontSize="18" TextColor="#222" FontAttributes="Bold" VerticalOptions="Center"></Label>
            <Label Text="KEMBALI" Grid.Column="1" FontSize="14" TextColor="CornflowerBlue" FontAttributes="Bold" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Cancel_Clicked" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <StackLayout Grid.Row="1" Padding="20,20,20,10" Spacing="5">
            <Label Text="Nama Rekening Akun" Margin="0,15,0,5" FontAttributes="Bold" TextColor="#444"></Label>
            <Border Padding="10,0" StrokeShape="RoundRectangle 8" Stroke="#CCCCCC" StrokeThickness="0.5" 
                        BackgroundColor="WhiteSmoke">

                <Entry x:Name="e_nama_rekening" ClearButtonVisibility="WhileEditing" 
                       VerticalTextAlignment="Center" Placeholder="Ex: Tunai, Bank Kaltim..."></Entry>
                

            </Border>
            
            <Label Text="Saldo Awal" Margin="0,10,0,0" FontAttributes="Bold" TextColor="#444"></Label>
            <Border Padding="10,0" StrokeShape="RoundRectangle 8" Stroke="#CCCCCC" StrokeThickness="0.5" 
                        BackgroundColor="WhiteSmoke">

                <Entry x:Name="e_saldoawal" Keyboard="Numeric" ClearButtonVisibility="WhileEditing" 
                       VerticalTextAlignment="Center" Placeholder="Ex: 100000..." TextChanged="e_saldoawal_TextChanged"></Entry>

            </Border>

            <StackLayout Orientation="Horizontal" Spacing="5" Margin="-10,10,0,0">
                <CheckBox x:Name="c_isactive" IsChecked="True" Color="CornflowerBlue"></CheckBox>
                <Label Text="Rekening Aktif" VerticalOptions="Center" TranslationY="-1" 
                       TextColor="Gray"
                       FontAttributes="Bold"></Label>
            </StackLayout>
            
            
            
        </StackLayout>

        <Button Text="SIMPAN REKENING" x:Name="BSimpan" Clicked="BSimpan_Clicked" FontAttributes="Bold" FontSize="18" CharacterSpacing="1" Grid.Row="2" Margin="20" 
                CornerRadius="20"
                BackgroundColor="CornflowerBlue"></Button>
                
        <!-- Overlay Loading -->
        <Grid x:Name="OverlayLoading" Grid.Row="0" Grid.RowSpan="3" BackgroundColor="#80000000" IsVisible="False" ZIndex="999">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                <ActivityIndicator IsRunning="{Binding Source={x:Reference OverlayLoading}, Path=IsVisible}" Color="White" WidthRequest="50" HeightRequest="50" />
                <Label Text="Mohon Tunggu..." TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>