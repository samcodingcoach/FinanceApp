<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  BackgroundColor="#f8fafa"
             x:Class="FinanceApp.Pengaturan.ListMenuPengaturan" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False"
             >
    
    <Grid RowDefinitions="Auto,*" Padding="10" RowSpacing="7">
        <Border Grid.Row="0" Padding="10" StrokeShape="RoundRectangle 10"  Stroke="Transparent" StrokeThickness="0.5" BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.10" Radius="12" Offset="0,-3" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*" ColumnSpacing="10">
                <Border Grid.Column="0" Padding="0" StrokeShape="RoundRectangle 10"  Stroke="#CCCCCC" StrokeThickness="0.5" BackgroundColor="White">
                    <SearchBar Placeholder="Cari menu pengaturan" x:Name="T_Search"></SearchBar>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="10" StrokeShape="RoundRectangle 10" Stroke="Transparent" StrokeThickness="0.5" BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.10" Radius="12" Offset="0,-3" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="5">
                <!-- Item 1: Biometric Sidik Jari -->
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="10,12" ColumnSpacing="15">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SettingFinger_Tapped" />
                    </Grid.GestureRecognizers>
                    <Image Source="fingerprint1.png" HeightRequest="24" Grid.Column="0" VerticalOptions="Center"></Image>
                    <Label Text="Biometric Sidik Jari" FontSize="15" TextColor="#444" Grid.Column="1" VerticalOptions="Center" FontAttributes="Bold"></Label>
                    <Image Source="chevron100.png" HeightRequest="18" TranslationY="2" VerticalOptions="Center" Rotation="-90" Grid.Column="2" HorizontalOptions="End"></Image>
                </Grid>

                <BoxView HeightRequest="0.5" Color="#f1f5f9" Margin="10,0" />

                <!-- Item 2: Atur Refresh Data Dashboard -->
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="10,12" ColumnSpacing="15">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SettingRefresh_Tapped" />
                    </Grid.GestureRecognizers>
                    <Image Source="refreshberanda1.png" HeightRequest="24" Grid.Column="0" VerticalOptions="Center"></Image>
                    <Label Text="Atur Refresh Data Dashboard" FontSize="15" TextColor="#444" Grid.Column="1" VerticalOptions="Center" FontAttributes="Bold"></Label>
                    <Image Source="chevron100.png" HeightRequest="18" TranslationY="2" VerticalOptions="Center" Rotation="-90" Grid.Column="2" HorizontalOptions="End"></Image>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>