<?xml version="1.0" encoding="utf-8" ?>
<the49:BottomSheet xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:the49="https://schemas.the49.com/dotnet/2023/maui"
                   BackgroundColor="White" Padding="0"
                   x:Class="FinanceApp.Transaksi.PilihFavorit_BottomSheet">

    <the49:BottomSheet.Detents>
        <the49:RatioDetent Ratio="0.65" />
    </the49:BottomSheet.Detents>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" Padding="20,24,20,20">
            <!-- Header & Close -->
            <StackLayout Orientation="Horizontal" Grid.Row="0">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Image Source="iconfavtx1.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                    <Label Text="Pilih Transaksi Favorit" FontAttributes="Bold" FontSize="17" TextColor="#222" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Image Source="close100.png" HeightRequest="22" WidthRequest="22" HorizontalOptions="EndAndExpand" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Close_Tapped" />
                    </Image.GestureRecognizers>
                </Image>
            </StackLayout>

            <!-- Search Bar -->
            <Border Grid.Row="1" Padding="0" StrokeShape="RoundRectangle 10" Stroke="#CCCCCC" StrokeThickness="0.5" BackgroundColor="WhiteSmoke">
                <SearchBar Placeholder="Cari transaksi favorit..." x:Name="T_Search" TextChanged="T_Search_TextChanged" />
            </Border>

            <!-- Collection List -->
            <CollectionView Grid.Row="2" x:Name="FavCollection" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 12" Padding="12" Margin="0,0,0,10" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="FavItem_Tapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.Shadow>
                                <Shadow Brush="#000000" Opacity="0.04" Radius="6" Offset="0,2" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="6">
                                <!-- Kategori Icon -->
                                <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{Binding BgColor}" WidthRequest="50" HeightRequest="50" VerticalOptions="Center" Padding="6" HorizontalOptions="Center">
                                    <Image Source="{Binding FullIconUrl}" Aspect="AspectFit" VerticalOptions="Center" HorizontalOptions="Center" />
                                </Border>

                                <!-- Title & Kategori -->
                                <StackLayout Grid.Column="1" Grid.Row="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding TitleDisplay}" FontAttributes="Bold" FontSize="15" TextColor="#222" LineBreakMode="TailTruncation" MaxLines="1" />
                                    <Label Text="{Binding nama_kategori}" FontSize="12" TextColor="CornflowerBlue" FontAttributes="Bold" />
                                </StackLayout>

                                <!-- Nominal -->
                                <Label Text="{Binding NominalDisplay}" Grid.Column="2" Grid.Row="0" HorizontalOptions="End" VerticalOptions="Center" FontSize="15" FontAttributes="Bold" TextColor="{Binding NominalColor}" />

                                <!-- Schedule Badge & Type -->
                                <StackLayout Orientation="Horizontal" Spacing="6" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1">
                                    <Border Padding="8,3" StrokeShape="RoundRectangle 6" StrokeThickness="0" BackgroundColor="#e8f0fe">
                                        <HorizontalStackLayout Spacing="4">
                                            <Image Source="date100.png" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
                                            <Label Text="{Binding ScheduleDisplay}" FontSize="11" FontAttributes="Bold" TextColor="#1967d2" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Border Padding="8,3" StrokeShape="RoundRectangle 6" StrokeThickness="0" BackgroundColor="{Binding TypeBadgeBg}">
                                        <Label Text="{Binding TypeText}" FontSize="11" FontAttributes="Bold" TextColor="{Binding TypeBadgeTextColor}" VerticalOptions="Center" />
                                    </Border>
                                </StackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Margin="0,40,0,0" Spacing="8">
                        <Label Text="Tidak ada transaksi favorit." TextColor="Grey" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#80000000" IsVisible="False">
            <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                <ActivityIndicator IsRunning="{Binding Source={x:Reference LoadingOverlay}, Path=IsVisible}" Color="White" WidthRequest="40" HeightRequest="40" />
                <Label Text="Memuat..." TextColor="White" FontAttributes="Bold" FontSize="14" />
            </StackLayout>
        </Grid>
    </Grid>
</the49:BottomSheet>
