<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Transaksi.New_Transaksi"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             BackgroundColor="#f8fafa"
             NavigationPage.HasNavigationBar="False" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False">
    <Grid>
        <ScrollView Margin="0,15">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Padding="20,10" RowSpacing="5">

                <!-- Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Grid.Row="0">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Image Source="backbiru1.png" HeightRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Back_Tapped" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label Text="Tambahkan Transaksi" FontAttributes="Bold" FontSize="16" 
                               TextColor="CornflowerBlue" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>

                    <!-- Tombol Impor dari Favorit (Model 2) -->
                    <Border Grid.Column="1" HorizontalOptions="End" Padding="10,5" StrokeShape="RoundRectangle 8" Stroke="Transparent" BackgroundColor="#e8f0fe">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="BtnImportFavorit_Tapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                            
                            <Label Text="Impor Favorit" FontSize="11" FontAttributes="Bold" TextColor="#1967d2" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Tombol Pilih Rekening -->
                    <Border Grid.Column="2" HorizontalOptions="End" Padding="12,5" StrokeShape="RoundRectangle 10" Stroke="Transparent" BackgroundColor="CornflowerBlue">
                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer x:Name="TapRekening" Tapped="TapRekening_Tapped" />
                            </StackLayout.GestureRecognizers>
                            <Image Source="wallet100.png" HeightRequest="14" />
                            <Label x:Name="LabelPilihRekening" Text="Pilih Rekening" FontSize="12" VerticalTextAlignment="Center" TextColor="White" />
                        </StackLayout>
                    </Border>
                </Grid>

                <!-- Banner Informasi Pengingat Jadwal Terdekat (Model 1) -->
                <Border x:Name="BannerReminderInfo" Grid.Row="1" Margin="0,10,0,0" Padding="12,10" StrokeShape="RoundRectangle 12" Stroke="#BFDBFE" StrokeThickness="1" BackgroundColor="#EFF6FF" IsVisible="False">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#DBEAFE" WidthRequest="36" HeightRequest="36" Padding="6" VerticalOptions="Center">
                            <Image Source="iconfavtx1.png" Aspect="AspectFit" VerticalOptions="Center" HorizontalOptions="Center" />
                        </Border>
                        
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label x:Name="L_BannerReminderTitle" Text="Pengingat: Tagihan Bulanan" FontSize="12" FontAttributes="Bold" TextColor="#1E40AF" LineBreakMode="TailTruncation" MaxLines="1" />
                            <Label x:Name="L_BannerReminderSubtitle" Text="Jadwal setiap tgl 10 (7 hari lagi) • Rp 150.000" FontSize="11" TextColor="#3B82F6" LineBreakMode="TailTruncation" MaxLines="1" />
                        </VerticalStackLayout>

                        <!-- Tombol Terapkan / Impor -->
                        <Border Grid.Column="2" Padding="10,6" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#2563EB" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ApplyBannerReminder_Tapped" />
                            </Border.GestureRecognizers>
                            <Label Text="Terapkan" FontSize="11" FontAttributes="Bold" TextColor="White" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Tipe Transaksi -->
                <Border Grid.Row="2" Margin="0,12,0,0" Padding="5" StrokeShape="RoundRectangle 10" Stroke="#CCCCCC" StrokeThickness="0.5" BackgroundColor="WhiteSmoke">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button x:Name="BPemasukan" Clicked="BPemasukan_Clicked" CornerRadius="10" FontAttributes="Bold" Text="PEMASUKAN" TextColor="DarkGrey" Grid.Column="0" BackgroundColor="Transparent" />
                        <Button x:Name="BPengeluaran" Clicked="BPengeluaran_Clicked" Text="PENGELUARAN" TextColor="White" FontAttributes="Bold" CornerRadius="10" Grid.Column="1" BackgroundColor="DarkCyan" />
                    </Grid>
                </Border>

                <!-- Nominal Transaksi -->
                <StackLayout Grid.Row="3" Margin="0,15">
                    <Label Text="NOMINAL TRANSAKSI" CharacterSpacing="3" FontSize="14" FontAttributes="Bold" HorizontalOptions="CenterAndExpand" TextColor="Grey" />
                    <Entry x:Name="T_Nominal" Keyboard="Numeric" Placeholder="0" FontAttributes="Bold" TextColor="CornflowerBlue" HorizontalOptions="Center" 
                           FontSize="32" HorizontalTextAlignment="Center" />
                </StackLayout>

                <!-- Kategori -->
                <Grid Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Label Text="Pilih Kategori" Grid.Row="0"></Label>
                    <CollectionView x:Name="KategoriCollectionView" Grid.Row="1" BackgroundColor="Transparent" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="10" HorizontalItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border WidthRequest="75" HorizontalOptions="Center" Padding="5,10" 
                                        StrokeShape="RoundRectangle 15" 
                                        Stroke="#ccc" StrokeThickness="1"
                                        BackgroundColor="White">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Kategori_Tapped" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    

                                    <StackLayout Spacing="7" VerticalOptions="Center">
                                        <Border WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" 
                                                Padding="5" StrokeShape="RoundRectangle 60" Stroke="LightGrey" StrokeThickness="0.3" BackgroundColor="{Binding IconBackgroundColor}">
                                            <Image Source="{Binding DisplayIcon}" HeightRequest="25"></Image>
                                        </Border>
                                        <Label Text="{Binding nama_kategori}" LineBreakMode="TailTruncation" TextColor="#444" FontSize="10" 
                                               HorizontalTextAlignment="Center" FontAttributes="Bold"></Label>
                                    </StackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <!-- NO STRUK, TANGGAL, JAM -->
                <Grid ColumnDefinitions="*,*,*" Grid.Row="5" Margin="0,10,0,0" ColumnSpacing="8">
                    <!-- NO STRUK -->
                    <Border Grid.Column="0" Padding="12,10" StrokeShape="RoundRectangle 10" Stroke="#CCCCCC" StrokeThickness="0.5" 
                            BackgroundColor="WhiteSmoke" HeightRequest="75">
                        <StackLayout>
                            <Label Text="NO. STRUK" FontSize="Caption" FontAttributes="Bold" TextColor="Grey"></Label>
                            <Entry x:Name="NoFaktur" Placeholder="Ex: 20260808" FontSize="13"></Entry>
                        </StackLayout>
                    </Border>

                    <!-- TANGGAL -->
                    <Border Grid.Column="1" Padding="12,10" StrokeShape="RoundRectangle 10" Stroke="#CCCCCC" StrokeThickness="0.5" 
                            BackgroundColor="WhiteSmoke" HeightRequest="75">
                        <StackLayout>
                            <Label Text="TANGGAL" FontSize="Caption" FontAttributes="Bold" TextColor="Grey"></Label>
                            <DatePicker x:Name="DP_Tanggal" Format="dd/MM/yyyy" FontSize="13" TranslationY="-5" TextColor="#444"></DatePicker>
                        </StackLayout>
                    </Border>

                    <!-- WAKTU / JAM -->
                    <Border Grid.Column="2" Padding="12,10" StrokeShape="RoundRectangle 10" Stroke="#CCCCCC" StrokeThickness="0.5" 
                            BackgroundColor="WhiteSmoke" HeightRequest="75">
                        <StackLayout>
                            <Label Text="JAM" FontSize="Caption" FontAttributes="Bold" TextColor="Grey"></Label>
                            <TimePicker x:Name="TP_Waktu" Format="HH:mm" FontSize="13" TranslationY="-5" TextColor="#444"></TimePicker>
                        </StackLayout>
                    </Border>
                </Grid>

                <!-- CATATAN -->
                <Border Grid.Row="6" Margin="0,10,0,0"  Padding="20,13" StrokeShape="RoundRectangle 10" Stroke="#CCCCCC" StrokeThickness="0.5" 
                        BackgroundColor="WhiteSmoke" HeightRequest="75">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackLayout Grid.Column="0">
                            <Label Text="CATATAN (OPSIONAL)" FontSize="Caption" FontAttributes="Bold" TextColor="Grey"></Label>
                            <Editor x:Name="T_Catatan" Placeholder="ex. Catatan atau Deskripsi"></Editor>
                        </StackLayout>
                            
                        <Image Source="edit10.png" HeightRequest="24" Grid.Column="1"></Image>
                    </Grid>
                </Border>
                
                <!-- DETAIL ITEM -->
                <Border Grid.Row="7" Margin="0,10,0,0"  Padding="20,13" StrokeShape="RoundRectangle 10" Stroke="#CCCCCC" StrokeThickness="0.5" 
                        BackgroundColor="WhiteSmoke" HeightRequest="75">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="DetailItem_Tapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackLayout Grid.Column="0" Spacing="10">
                            <Label Text="DETAIL ITEM" FontSize="Caption" FontAttributes="Bold" TextColor="Grey"></Label>
                            <Label x:Name="LabelDetailCount" Text="Tambah Detail Barang / Jasa"></Label>
                        </StackLayout>
                            
                        <Image Source="chevron100.png" Rotation="-90" HeightRequest="24" Grid.Column="1"></Image>
                    </Grid>
                </Border>
                
                <!-- NOTA / STRUK -->
                <Border Grid.Row="8" Margin="0,10,0,0"  Padding="20,13" StrokeShape="RoundRectangle 10" Stroke="#CCCCCC" StrokeThickness="1" StrokeDashArray="5,5" 
                        BackgroundColor="WhiteSmoke" HeightRequest="75">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <StackLayout Grid.Column="0" Spacing="10">
                            <Label Text="NOTA / STRUK (OPSIONAL)" FontSize="Caption" FontAttributes="Bold" TextColor="Grey"></Label>
                            <Label x:Name="LabelUploadStatus" Text="Upload Min 500kb"></Label>
                        </StackLayout>

                        <Image Source="camera1.png" HeightRequest="24" Grid.Column="1" Margin="15,0" TranslationX="-50">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Camera_Tapped" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Image Source="gallery1.png" HeightRequest="24" Grid.Column="2" TranslationX="-50">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Gallery_Tapped" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Border>


            </Grid>
        </ScrollView>
        
        <!-- Loading Overlay -->
        <Grid x:Name="OverlayLoading" BackgroundColor="#80000000" IsVisible="False">
            <ActivityIndicator IsRunning="{Binding Source={x:Reference OverlayLoading}, Path=IsVisible}" Color="White" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label x:Name="OverlayText" Text="Menyimpan..." TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,60,0,0" />
        </Grid>
        
        <!-- FAB Simpan -->
        <ImageButton Source="fabsave100.png" Clicked="BSimpan_Clicked" x:Name="BSimpan"
                     BackgroundColor="CornflowerBlue" Padding="15"
                     WidthRequest="60" HeightRequest="60" CornerRadius="30"
                     HorizontalOptions="End" VerticalOptions="End" Margin="20">
            <ImageButton.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.3" />
            </ImageButton.Shadow>
        </ImageButton>
    </Grid>
</ContentPage>