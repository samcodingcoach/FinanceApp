<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Transaksi.New_Transaksi"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             BackgroundColor="#f8fafa"
             NavigationPage.HasNavigationBar="False" Shell.NavBarIsVisible="False">
    <ScrollView Margin="0,30,0,30">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Padding="20,10" RowSpacing="5">

            <StackLayout Orientation="Horizontal" Spacing="10" Grid.Row="0">
                <Image Source="backbiru1.png" HeightRequest="24"></Image>
                <Label Text="Tambahkan Transaksi" FontAttributes="Bold" FontSize="16" 
                       TextColor="CornflowerBlue"
                       VerticalTextAlignment="Center"></Label>
            </StackLayout>

            <Border Grid.Row="1" Margin="0,10,0,0"  Padding="5" StrokeShape="RoundRectangle 10" Stroke="#CCCCCC" StrokeThickness="0.5" 
                BackgroundColor="WhiteSmoke">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <!--tipe-->
                    <Button x:Name="BPemasukan" Clicked="BPemasukan_Clicked" CornerRadius="10" FontAttributes="Bold" Text="PEMASUKAN" TextColor="DarkGrey" Grid.Column="0" BackgroundColor="Transparent"></Button>
                    <Button x:Name="BPengeluaran" Clicked="BPengeluaran_Clicked" Text="PENGELUARAN" TextColor="White" FontAttributes="Bold" CornerRadius="10" Grid.Column="1" BackgroundColor="DarkCyan"></Button>
                </Grid>
            </Border>

            <StackLayout Grid.Row="2" Margin="0,15">
                <Label Text="NOMINAL TRANSAKSI" CharacterSpacing="3" FontSize="14" FontAttributes="Bold" HorizontalOptions="CenterAndExpand" TextColor="Grey"></Label>
                <Entry Placeholder="0.00" FontAttributes="Bold" TextColor="CornflowerBlue" HorizontalOptions="Center" 
                       FontSize="32"
                       HorizontalTextAlignment="Center"></Entry>
            </StackLayout>

            <!--katagori-->

            <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="10">
                <Label Text="Pilih Kategori" ></Label>
                <!--pilihan kategori sesuai pemasukan atau pengeluaran 4 card per row-->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10" Grid.Row="1">
                    <Border WidthRequest="90" HorizontalOptions="Center" Padding="5,10" 
                            StrokeShape="RoundRectangle 15" 
                            Stroke="LightGrey" StrokeThickness="0.5" Grid.Column="0"
                            BackgroundColor="White">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Opacity="0.10" Radius="12" Offset="0,-3" />
                        </Border.Shadow>

                        <StackLayout Spacing="7" VerticalOptions="Center">
                            <Border WidthRequest="50" HeightRequest="50" HorizontalOptions="Center" 
                                    Padding="5" StrokeShape="RoundRectangle 60" Stroke="LightGrey" StrokeThickness="0.3" BackgroundColor="CornflowerBlue">
                                <Image Source="sampelicon1.png" HeightRequest="30"></Image>
                            </Border>
                            <Label Text="Kategori" LineBreakMode="TailTruncation" TextColor="#444" FontSize="12" 
                                   HorizontalTextAlignment="Center" FontAttributes="Bold"></Label>

                        </StackLayout>
                    </Border>


                    <Border WidthRequest="90" HorizontalOptions="Center" Padding="5,10" 
                            StrokeShape="RoundRectangle 15"  Grid.Column="1"
                            Stroke="LightGrey" StrokeThickness="0.5" 
                            BackgroundColor="White">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Opacity="0.10" Radius="12" Offset="0,-3" />
                        </Border.Shadow>
                        <!--kondisi tidak terselect-->
                        <StackLayout Spacing="7" VerticalOptions="Center">
                            <Border WidthRequest="50" HeightRequest="50" HorizontalOptions="Center" 
                                    StrokeShape="RoundRectangle 60" Stroke="LightGrey" StrokeThickness="0.3" BackgroundColor="LightGray">
                                <Image Source="edit10.png" HeightRequest="30"></Image>
                            </Border>
                            <Label Text="Kategori 2" LineBreakMode="TailTruncation" TextColor="#444" FontSize="12" 
                                        HorizontalTextAlignment="Center" FontAttributes="Bold"></Label>

                        </StackLayout>
                    </Border>

                </Grid>
            </Grid>

            <Border Grid.Row="4" Margin="0,10,0,0"  Padding="20,13" StrokeShape="RoundRectangle 10" Stroke="#CCCCCC" StrokeThickness="0.5" 
                    BackgroundColor="WhiteSmoke" HeightRequest="75">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackLayout Grid.Column="0">
                        <Label Text="TANGGAL" FontSize="Caption" FontAttributes="Bold" TextColor="Grey"></Label>
                        <DatePicker Format="dd MMMM yyyy" FontSize="16" TranslationY="-5" FontAttributes="Bold" TextColor="#444"></DatePicker>
                    </StackLayout>

                    <Image Source="date100.png" HeightRequest="24" Grid.Column="1"></Image>
                </Grid>
            </Border>
            <Border Grid.Row="5" Margin="0,10,0,0"  Padding="20,13" StrokeShape="RoundRectangle 10" Stroke="#CCCCCC" StrokeThickness="0.5" 
                    BackgroundColor="WhiteSmoke" HeightRequest="75">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackLayout Grid.Column="0">
                        <Label Text="CATATAN (OPSIONAL)" FontSize="Caption" FontAttributes="Bold" TextColor="Grey"></Label>
                        <Editor Placeholder="ex. Catatan atau Deskripsi"></Editor>
                    </StackLayout>
                        
                    <Image Source="edit10.png" HeightRequest="24" Grid.Column="1"></Image>
                </Grid>
            </Border>
            
            <Border Grid.Row="6" Margin="0,10,0,0"  Padding="20,13" StrokeShape="RoundRectangle 10" Stroke="#CCCCCC" StrokeThickness="0.5" 
                    BackgroundColor="WhiteSmoke" HeightRequest="75">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackLayout Grid.Column="0" Spacing="10">
                        <Label Text="DETAIL ITEM" FontSize="Caption" FontAttributes="Bold" TextColor="Grey"></Label>
                        <Label Text="Tambah Detail Barang / Jasa"></Label>
                    </StackLayout>
                        
                    <Image Source="chevron100.png" Rotation="-90" HeightRequest="24" Grid.Column="1"></Image>
                </Grid>
            </Border>
            <Border Grid.Row="7" Margin="0,10,0,0"  Padding="20,13" StrokeShape="RoundRectangle 10" Stroke="#CCCCCC" StrokeThickness="1" StrokeDashArray="5,5" 
                    BackgroundColor="WhiteSmoke" HeightRequest="75">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <StackLayout Grid.Column="0" Spacing="10">
                        <Label Text="NOTA / STRUK (OPSIONAL)" FontSize="Caption" FontAttributes="Bold" TextColor="Grey"></Label>
                        <Label Text="Upload Min 500kb"></Label>
                    </StackLayout>

                    <Image Source="camera1.png" HeightRequest="24" Grid.Column="1" Margin="15,0"></Image>
                    <Image Source="download1.png" HeightRequest="24" Grid.Column="2"></Image>
                </Grid>
            </Border>

            <Button Grid.Row="8" Text="SIMPAN TRANSAKSI" x:Name="BSimpan" FontAttributes="Bold" FontSize="18" CharacterSpacing="1" 
              CornerRadius="20" Margin="0,15,0,0" BackgroundColor="CornflowerBlue"></Button>

        </Grid>
    </ScrollView>
</ContentPage>