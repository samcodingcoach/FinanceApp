<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Transaksi.PilihRekening_BottomSheet"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="PilihRekening_BottomSheet">
    <Grid RowDefinitions="Auto,*,Auto" Padding="20">
        <Label Text="Pilih Rekening"></Label>
        <Border VerticalOptions="Start" Margin="0,0,0,10" StrokeShape="RoundRectangle 10" 
        Stroke="#CCCCCC" StrokeThickness="0.2" BackgroundColor="White">
            <Grid ColumnDefinitions="Auto,*,Auto" Padding="20" ColumnSpacing="15">
                <toolkit:AvatarView ImageSource="tunai100.png" Grid.Column="0" 
                            WidthRequest="50" HeightRequest="50" CornerRadius="25"
                            BackgroundColor="CornflowerBlue" />

                <StackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Tunai" FontSize="16" FontAttributes="Bold" TextColor="#444"></Label>
                    <Label Text="08 Agustus 2026" FontSize="Small" TextColor="Grey"></Label>
                </StackLayout>

                <Label Grid.Column="2" FontAttributes="Bold" FontSize="22" TextColor="Goldenrod"
                       Text="Rp 1.000.000" VerticalOptions="Center"></Label>
            </Grid>
        </Border>
    </Grid>
</ContentPage>