<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Beranda"
             BackgroundColor="#f5fbf5" NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="True">

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            
            <!-- Total Balance Card -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="CornflowerBlue" Padding="24" HeightRequest="180">
                <Border.Shadow>
                    <Shadow Brush="DarkSlateBlue" Opacity="0.4" Radius="20" Offset="0,4" />
                </Border.Shadow>
                <Grid>
                    <!-- Background Icon -->
                    <Image Source="wallet100.png" Opacity="0.1" HorizontalOptions="End" VerticalOptions="Start" 
                           WidthRequest="120" HeightRequest="120" Margin="0,-30,-10,-30" Rotation="180" />

                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="TOTAL SALDO" FontSize="12" FontAttributes="Bold" TextColor="#e6ffffff" CharacterSpacing="1" VerticalOptions="Center" />
                            
                            <!-- Countdown Badge Pill -->
                            <Border Grid.Column="1" BackgroundColor="#29ffffff" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="8,4" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                    <Image x:Name="ImgRefreshIcon" Source="refreshberanda1.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                                    <Label x:Name="L_Countdown" Text="--:--" FontSize="11" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                        <!--total_saldo_akhir : total-->
                        <Label x:Name="L_TotalSaldo" Text="Rp 0" FontSize="32" FontAttributes="Bold" TextColor="White" Margin="0,5,0,0" />
                        
                        <HorizontalStackLayout Spacing="16" Margin="0,24,0,0">
                            <!-- Top Up / Transaksi Baru Button -->
                            <Border BackgroundColor="#33ffffff" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="16,8">
                                <HorizontalStackLayout Spacing="8">
                                    <Image Source="buy1.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                                    <Label Text="Transaksi Baru" FontSize="14" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TransaksiBaru_Tapped" />
                                </Border.GestureRecognizers>
                            </Border>

                           
                           
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Income & Expense Summary Bento -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <!-- Income -->
                <Border Grid.Column="0" BackgroundColor="#ffffff" Stroke="#f1f5f9" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.05" Radius="8" Offset="0,2" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="5">
                            <Image Source="arrowdown.png" WidthRequest="20" HeightRequest="20"/>
                            <Label Text="Pemasukan" FontSize="12" FontAttributes="Bold" TextColor="#006948" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <!--dashboard_pengeluaran_pemasukan, pemasukan-->
                        <Label x:Name="L_Pemasukan" Text="Rp 0" FontSize="16" FontAttributes="Bold" TextColor="#171d19" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Expense -->
                <Border Grid.Column="1" BackgroundColor="#ffffff" Stroke="#f1f5f9" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.05" Radius="8" Offset="0,2" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="5">
                            <Image Source="arrowup1.png" WidthRequest="20" HeightRequest="20"/>
                            <Label Text="Pengeluaran" FontSize="12" FontAttributes="Bold" TextColor="#ba5551" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <!--dashboard_pengeluaran_pemasukan, pengeluaran-->
                        <Label x:Name="L_Pengeluaran" Text="Rp 0" FontSize="16" FontAttributes="Bold" TextColor="#171d19" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Reminder Transaksi Favorit / Berulang (Horizontal Scroll) -->
            <VerticalStackLayout x:Name="SectionReminder" Spacing="12" IsVisible="False">
                <Grid ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        
                        <Label Text="Favorit &amp; Rutin" FontSize="18" FontAttributes="Bold" TextColor="#171d19" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    
                </Grid>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="HS_ReminderFavorit" Spacing="12" Padding="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#ffffff" Stroke="#f1f5f9" StrokeThickness="1" StrokeShape="RoundRectangle 14"  Padding="14">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.06" Radius="8" Offset="0,2" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ReminderItem_Tapped" CommandParameter="{Binding id_fav}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="10">
                                        <!-- Header Card: Icon Category & Schedule Badge -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Grid.Column="0" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="{Binding BgColor}" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" Padding="6">
                                                <Image Source="{Binding FullIconUrl}" Aspect="AspectFit" VerticalOptions="Center" HorizontalOptions="Center" />
                                            </Border>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="{Binding TitleDisplay}" FontAttributes="Bold" TextColor="#333" LineBreakMode="TailTruncation" MaxLines="1" />
                                                <Label Text="{Binding NominalDisplay}" FontSize="16" VerticalTextAlignment="Center" FontAttributes="Bold" TextColor="{Binding NominalColor}" Margin="0,2,0,0" />
                                            </StackLayout>

                                            <Border VerticalOptions="Center" HorizontalOptions="Start" Padding="8,4" Grid.Column="2"  StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#e8f0fe">
                                                <HorizontalStackLayout Spacing="4">

                                                    <Label Text="{Binding ScheduleDisplay}" FontSize="Caption" FontAttributes="Bold" TextColor="#1967d2" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </Grid>

                                        <!-- Keterangan & Nama Kategori -->
                                        
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <!-- Budgeting Progress -->
            <Border BackgroundColor="#ffffff" Stroke="#f1f5f9" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.05" Radius="8" Offset="0,2" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Anggaran Bulanan" FontSize="18" FontAttributes="Bold" TextColor="#171d19" />
                        <Label x:Name="L_AnggaranTerpakaiPersen" Grid.Column="1" Text="Terpakai 0%" FontSize="14" FontAttributes="Bold" TextColor="CornflowerBlue" VerticalOptions="Center" />
                    </Grid>
                    
                    <ProgressBar x:Name="PB_Anggaran" Progress="0" ProgressColor="#006948" BackgroundColor="#e4eae4" HeightRequest="8" />
                    
                    <Label x:Name="L_AnggaranTersisa" Text="Tersisa Rp 0 untuk bulan ini." FontSize="14" TextColor="#3d4a42" />
                </VerticalStackLayout>
            </Border>

            <!-- Menu -->
            <Border BackgroundColor="#ffffff" Stroke="#f1f5f9" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.05" Radius="8" Offset="0,2" />
                </Border.Shadow>
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="5" RowDefinitions="Auto,Auto" RowSpacing="10">
                    <!--Rekening\List-Akun.xaml-->
                    <StackLayout x:Name="MenuRekening" Grid.Column="0" Grid.Row="0">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="MenuRekening_Tapped" />
                        </StackLayout.GestureRecognizers>
                        <Image Source="menu_akun.png" HeightRequest="42"></Image>
                        <Label Text="Rekening" HorizontalTextAlignment="Center" FontSize="14" FontAttributes="Bold" TextColor="#444"></Label>
                    </StackLayout>
                    <!--Kategori\List_Kategori.xaml-->
                    <StackLayout x:Name="MenuKategori" Grid.Column="1" Grid.Row="0">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="MenuKategori_Tapped" />
                        </StackLayout.GestureRecognizers>
                        <Image Source="menu_kategori.png" HeightRequest="42"></Image>
                        <Label Text="Kategori" HorizontalTextAlignment="Center" FontSize="14" FontAttributes="Bold" TextColor="#444"></Label>
                    </StackLayout>
                    <!--Budget\List_Budget.xaml-->
                    <StackLayout x:Name="MenuAnggaran" Grid.Column="2" Grid.Row="0">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="MenuAnggaran_Tapped" />
                        </StackLayout.GestureRecognizers>
                        <Image Source="menu_budget.png" HeightRequest="42"></Image>
                        <Label Text="Anggaran" HorizontalTextAlignment="Center" FontSize="14" FontAttributes="Bold" TextColor="#444"></Label>
                    </StackLayout>
                    <!--Users\List_Users.xaml-->
                    <StackLayout x:Name="MenuPengguna" Grid.Column="3" Grid.Row="0">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="MenuPengguna_Tapped" />
                        </StackLayout.GestureRecognizers>
                        <Image Source="menu_user.png" HeightRequest="42"></Image>
                        <Label Text="Pengguna" HorizontalTextAlignment="Center" FontSize="14" FontAttributes="Bold" TextColor="#444"></Label>
                    </StackLayout>
                    <!--pengaturan-->
                    <StackLayout x:Name="MenuPengaturan" Grid.Column="4" Grid.Row="0">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="MenuPengaturan_Tapped" />
                        </StackLayout.GestureRecognizers>
                        <Image Source="menu_config.png" HeightRequest="42" />
                        <Label Text="Pengaturan" LineBreakMode="TailTruncation" MaxLines="1" HorizontalTextAlignment="Center" FontSize="14" FontAttributes="Bold" TextColor="#444" />
                    </StackLayout>

                    <StackLayout x:Name="MenuFav" Grid.Column="0" Grid.Row="1">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="MenuFav_Tapped" />
                        </StackLayout.GestureRecognizers>
                        <Image Source="iconfavtx1.png" HeightRequest="42"></Image>
                        <Label Text="Berulang" LineBreakMode="TailTruncation" MaxLines="1" HorizontalTextAlignment="Center" FontSize="14" FontAttributes="Bold" TextColor="#444"></Label>
                    </StackLayout>

                </Grid>
            </Border>

            <!-- Member Spending Ranking -->
            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Pengeluaran Anggota" FontSize="18" FontAttributes="Bold" TextColor="#171d19" />
                    <Label Grid.Column="1" Text="Lihat Semua" FontSize="14" FontAttributes="Bold" TextColor="#006948" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="LihatSemuaPengeluaran_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Border BackgroundColor="#ffffff" Stroke="#dee4de" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.05" Radius="8" Offset="0,2" />
                    </Border.Shadow>
                    <VerticalStackLayout x:Name="VS_PengeluaranAnggota" Spacing="16">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="12">
                                            
                                            <Border BackgroundColor="{Binding AvatarBgColor}" StrokeThickness="0" StrokeShape="RoundRectangle 16" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                                <Image Source="{Binding PhotoUrl}" Aspect="AspectFill"></Image>
                                            </Border>

                                            <Label Text="{Binding Urutan}" FontSize="12" FontAttributes="Bold" TextColor="{Binding AvatarTextColor}" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Label Text="{Binding Nama}" FontSize="16" FontAttributes="Bold" TextColor="#444" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Nominal}" FontSize="18" FontAttributes="Bold" TextColor="{Binding NominalColor}" VerticalOptions="Center" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding ProgressValue}" ProgressColor="{Binding ProgressColor}" BackgroundColor="#e9efe9" HeightRequest="8" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Recent Documents Section (Horizontal) -->
            <VerticalStackLayout Spacing="15">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Dokumen Terakhir" FontSize="18" FontAttributes="Bold" TextColor="#171d19" />
                </Grid>

                <ScrollView x:Name="SV_Dokumen" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="HS_DokumenTerakhir" Spacing="10" Padding="4">
                        <BindableLayout.EmptyView>
                            <VerticalStackLayout WidthRequest="{Binding Width, Source={x:Reference SV_Dokumen}}" HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0, 20">
                                <Image Source="empty2.png" WidthRequest="100" HeightRequest="100" HorizontalOptions="Center" />
                                <Label Text="Data tidak ditemukan" TextColor="#666" FontSize="14" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#ffffff" Stroke="#dee4de" StrokeThickness="1" StrokeShape="RoundRectangle 12" WidthRequest="256" Padding="0">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.05" Radius="8" Offset="0,2" />
                                    </Border.Shadow>
                                    <VerticalStackLayout>
                                        <!-- Image Header -->
                                        <Grid HeightRequest="125" BackgroundColor="#e9efe9">
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" Opacity="0.8" />
                                        </Grid>
                                        
                                        <!-- Content -->
                                        <StackLayout Orientation="Horizontal" Padding="16" Spacing="4">
                                            <StackLayout>
                                                <Label Text="{Binding Judul}" FontSize="16" FontAttributes="Bold" TextColor="#171d19" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Subtitle}" FontSize="14" TextColor="#3d4a42" />
                                            </StackLayout>

                                            <Image Source="download1.png" HeightRequest="20" TranslationX="-5" HorizontalOptions="EndAndExpand" Opacity="0.6" IsVisible="{Binding IsDownloadVisible}">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="Download_Tapped" CommandParameter="{Binding ImageUrl}" />
                                                </Image.GestureRecognizers>
                                            </Image>                                           
                                        </StackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <!-- Recent Transactions Section (Vertical) -->
            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Transaksi Terakhir" FontSize="18" FontAttributes="Bold" TextColor="#171d19" />
                    <Label Grid.Column="1" Text="Lihat Semua" FontSize="14" FontAttributes="Bold" TextColor="#006948" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <VerticalStackLayout x:Name="VS_TransaksiTerakhir" Spacing="0">
                    <BindableLayout.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0, 20">
                            <Image Source="empty2.png" WidthRequest="100" HeightRequest="100" HorizontalOptions="Center" />
                            <Label Text="Data tidak ditemukan" TextColor="#666" FontSize="14" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <ContentView Padding="4">
                                <Border BackgroundColor="#ffffff" Stroke="#f1f5f9" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.05" Radius="8" Offset="0,2" />
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                        <Border Grid.Column="0" BackgroundColor="{Binding IconBgColor}" StrokeThickness="0" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40">
                                            <Image Source="{Binding IconImage}" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" HorizontalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Judul}" FontSize="16" FontAttributes="Bold" TextColor="#171d19" />
                                            <Label Text="{Binding Tanggal}" FontSize="14" TextColor="#3d4a42" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding Nominal}" FontSize="16" FontAttributes="Bold" TextColor="{Binding NominalColor}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </ContentView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>