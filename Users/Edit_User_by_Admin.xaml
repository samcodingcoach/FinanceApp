<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Users.Edit_User_by_Admin"
             BackgroundColor="#f8fafa"
             NavigationPage.HasNavigationBar="False" 
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False">
             
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Custom Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,20,20,15" BackgroundColor="White">
            <Grid.Shadow>
                <Shadow Brush="#000000" Opacity="0.05" Radius="5" Offset="0,2" />
            </Grid.Shadow>
            <Label Text="Edit User" FontSize="18" TextColor="#222" FontAttributes="Bold" VerticalOptions="Center"></Label>
            <Label Text="KEMBALI" Grid.Column="1" FontSize="14" TextColor="CornflowerBlue" FontAttributes="Bold" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Cancel_Clicked" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <StackLayout Padding="20">


                <toolkit:AvatarView x:Name="ImgPhoto" BackgroundColor="WhiteSmoke" 
                            BorderColor="Grey" BorderWidth="0.3" CornerRadius="100"
                            HeightRequest="100" WidthRequest="100"
                            TextColor="WhiteSmoke" ImageSource="dotnet_bot.png">
                    <toolkit:AvatarView.GestureRecognizers>
                        <TapGestureRecognizer />
                    </toolkit:AvatarView.GestureRecognizers>
                </toolkit:AvatarView>

                <Label Text="Username" Margin="0,15,0,10" FontAttributes="Bold" TextColor="#444"></Label>
                <Border Padding="10,0" StrokeShape="RoundRectangle 10" Stroke="#CCCCCC" StrokeThickness="0.5" 
                        BackgroundColor="WhiteSmoke">
                    <!--p_username: disabled/readonly usually for edit, but let's make it editable if admin wants-->
                    <Entry x:Name="e_username" ClearButtonVisibility="WhileEditing" MaxLength="15" IsReadOnly="True"
                             VerticalTextAlignment="Center" Placeholder="Ex: Budiono"></Entry>
                </Border>
                
                <Border Padding="15" Margin="0,15" StrokeShape="RoundRectangle 10" Stroke="#CCCCCC" StrokeThickness="0.5" 
                        BackgroundColor="White">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackLayout VerticalOptions="Center">
                            <Label Text="User Aktif" TextColor="#444" FontSize="16" FontAttributes="Bold"></Label>
                            <Label Text="Izinkan pengguna user ini mengakses sistem" TextColor="Grey" FontSize="Small"></Label>
                        </StackLayout>
                        <Switch x:Name="c_isactive" IsToggled="True" OnColor="CornflowerBlue" VerticalOptions="Center"></Switch>
                    </Grid>
                </Border>

            </StackLayout>
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="20,15">
            <Button Text="HAPUS" Grid.Column="0" x:Name="BDelete" Clicked="BDelete_Clicked"  FontAttributes="Bold" FontSize="18" CharacterSpacing="1" 
                    CornerRadius="20" BackgroundColor="IndianRed"></Button>
            <Button Text="UPDATE" Grid.Column="1" x:Name="BSimpan" Clicked="BSimpan_Clicked"  FontAttributes="Bold" FontSize="18" CharacterSpacing="1" 
                    CornerRadius="20" BackgroundColor="CornflowerBlue"></Button>

        </Grid>

        <Grid x:Name="OverlayLoading" Grid.Row="0" Grid.RowSpan="3" BackgroundColor="#80000000" IsVisible="False" ZIndex="999">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                <ActivityIndicator IsRunning="{Binding Source={x:Reference OverlayLoading}, Path=IsVisible}" Color="White" WidthRequest="50" HeightRequest="50" />
                <Label Text="Menyimpan Data..." TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid x:Name="OverlayDelete" Grid.Row="0" Grid.RowSpan="3" BackgroundColor="#E6000000" IsVisible="False" ZIndex="1000">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
                <Label x:Name="L_DeleteCountdown" Text="Menghapus dalam 5..." TextColor="White" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                <Button Text="BATALKAN" x:Name="BCancelDelete" Clicked="BCancelDelete_Clicked" BackgroundColor="Transparent" BorderColor="White" BorderWidth="2" TextColor="White" CornerRadius="20" WidthRequest="150" FontAttributes="Bold"></Button>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>