<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Users.Transaksi_Users"
             Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False"
             BackgroundColor="#f8fafc">

    <Grid>
        <Grid RowDefinitions="Auto,*">
            <!-- Custom Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,20,20,15" BackgroundColor="White">
                <Grid.Shadow>
                    <Shadow Brush="#000000" Opacity="0.05" Radius="5" Offset="0,2" />
                </Grid.Shadow>
                <Label Text="Riwayat Transaksi" FontSize="18" TextColor="#444" FontAttributes="Bold" VerticalOptions="Center"></Label>
                <Label Text="KEMBALI" Grid.Column="1" FontSize="14" TextColor="CornflowerBlue" FontAttributes="Bold" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Back_Tapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Main Content -->
            <RefreshView Grid.Row="1" x:Name="RefreshData" Refreshing="RefreshData_Refreshing">
                <ScrollView Padding="16,16,16,80">
            <VerticalStackLayout>
                <!-- Loading Indicator -->
                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="True" IsVisible="True" Color="#059669" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,50,0,0" />

                <!-- List Item Transaksi Grouped -->
                <VerticalStackLayout x:Name="GroupedDataCollection" Spacing="24">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="8">
                                <!-- Group Header -->
                                <Grid ColumnDefinitions="*,Auto" Padding="8,8,8,0">
                                    <Label Grid.Column="0" Text="{Binding TanggalFormat}" FontFamily="Inter" FontSize="20" FontAttributes="Bold" TextColor="#3d4a42" />
                                    <Label Grid.Column="1" Text="{Binding TotalFormat}" FontFamily="Inter" FontSize="18" FontAttributes="Bold" TextColor="#059669" VerticalOptions="Center" />
                                </Grid>
                                
                                <!-- Group Items inside a Card -->
                                <Border BackgroundColor="#ffffff" Stroke="#f1f5f9" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.05" Radius="8" Offset="0,2" />
                                    </Border.Shadow>
                                    
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <VerticalStackLayout>
                                                    <Grid ColumnDefinitions="*,Auto" Padding="20,10">
                                                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                                                            <Label Text="{Binding nama_barang_jasa}" FontFamily="Inter" FontSize="16" TextColor="#171d19" />
                                                            <Label Text="{Binding HargaFormat}" FontFamily="Inter" FontSize="14" TextColor="#505f76" />
                                                        </VerticalStackLayout>
                                                        <Label Grid.Column="1" Text="{Binding SubtotalFormat}" FontFamily="Inter" FontSize="16" FontAttributes="Bold" TextColor="#444" VerticalOptions="Center" />
                                                    </Grid>
                                                    <BoxView HeightRequest="1" Color="#f1f5f9" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
                </ScrollView>
            </RefreshView>
        </Grid>
        
        <!-- FAB (Export PDF) -->
        <Border BackgroundColor="CornflowerBlue" StrokeThickness="0" StrokeShape="RoundRectangle 25" 
                WidthRequest="50" HeightRequest="50" HorizontalOptions="End" VerticalOptions="End" Margin="20,20,20,30">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.2" Radius="5" Offset="0,4" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="FAB_ExportPdf_Tapped" />
            </Border.GestureRecognizers>
            <Image Source="download1.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" HorizontalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>